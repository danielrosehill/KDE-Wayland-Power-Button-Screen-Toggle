#!/usr/bin/python3
"""Power button = screen on/off toggle, and nothing else wakes the screens.

Grabs the ACPI "Power Button" input devices exclusively (logind, PowerDevil, KWin never see the key).
Press -> screens off (KWin DPMS via kscreen-doctor) and EVIOCGRAB every other keyboard/mouse so input
can't wake them. Press again -> screens on, grabs released. Stopping the service releases all grabs.
Remote control (e.g. a Home Assistant / MQTT agent): SIGUSR1 = screens off, SIGUSR2 = screens on, same
behaviour as the button:  systemctl --user kill -s SIGUSR1 screen-toggle
Current state ("on"/"off") is written to $XDG_STATE_HOME/screen-toggle/state (default ~/.local/state).
Repo: https://github.com/danielrosehill/KDE-Wayland-Power-Button-Screen-Toggle
"""
import os, select, signal, subprocess, sys, time
import evdev
from evdev import ecodes as E

def log(*a): print(*a, flush=True)

def dpms(mode):
    subprocess.run(["kscreen-doctor", "--dpms", mode], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def is_power(d): return d.name == "Power Button"

def is_input(d):
    caps = d.capabilities()
    keys = set(caps.get(E.EV_KEY, []))
    return E.EV_REL in caps or E.EV_ABS in caps or E.KEY_A in keys or E.KEY_SPACE in keys or E.BTN_LEFT in keys

power = []
for p in evdev.list_devices():
    d = evdev.InputDevice(p)
    if is_power(d):
        d.grab(); power.append(d)
    else:
        d.close()
if not power: log("no Power Button device"); sys.exit(1)
log("holding", [d.path for d in power])

off = False
grabbed = {}
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "screen-toggle", "state")

def write_state():
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f: f.write("off\n" if off else "on\n")
        os.replace(STATE + ".tmp", STATE)
    except OSError as e: log("state file:", e)

def grab_inputs():
    for p in evdev.list_devices():
        if p in grabbed: continue
        try:
            d = evdev.InputDevice(p)
        except OSError: continue
        if is_power(d) or not is_input(d): d.close(); continue
        try: d.grab(); grabbed[p] = d
        except OSError: d.close()   # e.g. already grabbed by input-remapper; its virtual device gets grabbed instead

def release_inputs():
    for d in grabbed.values():
        try: d.ungrab()
        except OSError: pass
        d.close()
    grabbed.clear()

def screens_on(*_):
    global off
    dpms("on"); release_inputs(); off = False; write_state()

def screens_off():
    global off
    grab_inputs(); time.sleep(0.3); dpms("off"); off = True; write_state()

def stop(*_):
    screens_on(); sys.exit(0)
signal.signal(signal.SIGTERM, stop); signal.signal(signal.SIGINT, stop)

# SIGUSR1/SIGUSR2 only queue a request; the main loop acts on it (a wakeup fd makes select() return at once).
pending = []
wake_r, wake_w = os.pipe(); os.set_blocking(wake_r, False); os.set_blocking(wake_w, False)
signal.set_wakeup_fd(wake_w)
signal.signal(signal.SIGUSR1, lambda *_: pending.append("off"))
signal.signal(signal.SIGUSR2, lambda *_: pending.append("on"))
write_state()

last = 0.0
while True:
    r, _, _ = select.select(power + [wake_r], [], [], 2.0)
    if wake_r in r:
        try: os.read(wake_r, 64)
        except BlockingIOError: pass
    while pending:
        want = pending.pop(0)
        if want == "off" and not off: screens_off(); log("screens off (signal), grabbed", len(grabbed))
        elif want == "on" and off: screens_on(); log("screens on (signal)")
    if off: grab_inputs()            # pick up devices plugged in while the screens are off
    for d in r:
        if d is wake_r: continue
        for ev in d.read():
            if ev.type == E.EV_KEY and ev.code == E.KEY_POWER and ev.value == 0:   # on release
                if time.monotonic() - last < 1.0: continue
                last = time.monotonic()
                if off:
                    screens_on(); log("screens on")
                else:
                    screens_off()
                    log("screens off, grabbed", len(grabbed))
