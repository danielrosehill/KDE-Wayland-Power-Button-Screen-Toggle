[Unit]
Description=Power button toggles screens; input can't wake them (~/.local/bin/screen-toggle)
PartOf=graphical-session.target
After=graphical-session.target plasma-kwin_wayland.service

[Service]
ExecStart=%h/.local/bin/screen-toggle
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
